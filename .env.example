# ---------------------------------------------------------------------------
# Bats AI — copy to ".env" for local development.
# On Render, set these in Dashboard → Environment instead (never commit real keys).
# ---------------------------------------------------------------------------

# ---- Chat model providers (any subset works — keys can also be pasted in the UI)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1     # optional proxy
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Defaults
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048

# ---- Image generation
IMAGE_PROVIDER=pollinations        # pollinations (free) | openai | openai_images_custom
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1
IMAGE_API_KEY=

# ---- Real web search (best first). With none of these the app uses
#      DuckDuckGo + Wikipedia automatically, so search still works.
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=
# SEARXNG_URL=https://searx.example.com
WEB_SEARCH_DEFAULT=true
MAX_SEARCH_RESULTS=6
PAGES_TO_READ=3

# ---- Storage & limits
DATA_DIR=./data
MAX_UPLOAD_MB=20
MAX_ATTACHMENTS=6
PUBLIC_URL=http://localhost:8000
