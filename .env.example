# ---------------------------------------------------------------------------
# Bats AI — copy to ".env" for local development.
# On Render, set these in Dashboard → Environment instead (never commit real keys).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# FREE MODE — nothing below is required. With these defaults the app answers,
# searches the web and makes images with no keys at all.
FREE_MODE=true
# FREE_LLM_BASE_URL=https://text.pollinations.ai/openai   # free text endpoint
# FREE_LLM_MODEL=openai                                   # first free model to try
# POLLINATIONS_TOKEN=                                     # free token: higher limits

# ---------------------------------------------------------------------------
# OPTIONAL: paid model providers (keys can also be pasted in the UI)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1     # optional proxy
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Defaults (leave unset to keep Bats Free as the default)
# DEFAULT_PROVIDER=openai
# DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048

# ---- Image generation
IMAGE_PROVIDER=pollinations        # pollinations (free) | demo (offline) | openai
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1
IMAGE_API_KEY=

# ---- Real web search (optional). With none of these the app uses
#      DuckDuckGo, Google News, Mojeek, Hacker News and Wikipedia automatically.
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=
# SEARXNG_URL=https://searx.example.com
WEB_SEARCH_DEFAULT=true
MAX_SEARCH_RESULTS=6
PAGES_TO_READ=3

# ---- Demo/offline placeholder answers when free models are busy
DEMO_MODE=true

# ---- Storage & limits
DATA_DIR=./data
MAX_UPLOAD_MB=20
MAX_ATTACHMENTS=6
PUBLIC_URL=http://localhost:8000
